# ============================================================
#  Frontend (Vite) environment variables
#  Copy this file to .env.local (gitignored) and fill in values.
#  These are baked into the build via import.meta.env.VITE_*.
# ============================================================

# ------------------------------------------------------------
#  Meta (Facebook) Pixel ID — web analytics & conversions.
#  Leave empty to disable the pixel entirely.
#  Find the number in Meta Events Manager → your pixel → Settings.
#  Example: VITE_META_PIXEL_ID=1234567890123456
# ------------------------------------------------------------
VITE_META_PIXEL_ID=
