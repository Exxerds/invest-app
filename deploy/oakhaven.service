# ============================================================
#  systemd unit for the app ON THE BACKEND VPS (PrivateAlps).
#
#  Install:
#    sudo cp deploy/oakhaven.service /etc/systemd/system/oakhaven.service
#    sudo systemctl daemon-reload
#    sudo systemctl enable --now oakhaven
#
#  Logs:
#    sudo journalctl -u oakhaven -f
#    tail -f /opt/oakhaven/server/server.log
# ============================================================
[Unit]
Description=Oak Haven Yield — site + API (Node.js)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=oakhaven
Group=oakhaven

# dotenv reads server/.env relative to this directory
WorkingDirectory=/opt/oakhaven/server

Environment=NODE_ENV=production

# Check the real path with:  which node
ExecStart=/usr/bin/node /opt/oakhaven/server/src/index.js

Restart=always
RestartSec=3

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/oakhaven/server

[Install]
WantedBy=multi-user.target
