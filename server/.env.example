# ============================================================
#  Server configuration — copy this file to server/.env
#
#      cp server/.env.example server/.env
#
#  Everything below has a safe default for local development.
#  The values marked REQUIRED IN PRODUCTION must be set before
#  the site goes live.
# ============================================================

# Port the API listens on.
# In production the same port also serves the built website.
PORT=4000

# Set to "production" on the server. This enables strict CORS,
# static file serving and refuses to boot with a default JWT secret.
NODE_ENV=development

# ------------------------------------------------------------
#  REQUIRED IN PRODUCTION — token signing key
# ------------------------------------------------------------
# Anyone who knows this string can forge an admin session.
# Generate a unique one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-long-random-string

# ------------------------------------------------------------
#  Public address (used for links inside e-mails)
# ------------------------------------------------------------
# Example: https://oakhavenyield.com
# If left empty the server derives it from the incoming request,
# which already works behind nginx — but setting it is safer.
SITE_URL=http://localhost:3000

# ------------------------------------------------------------
#  CORS — only needed if the API lives on a DIFFERENT domain
#  than the website. Same-domain deployments can leave it empty.
#  Comma-separated list, e.g. https://oakhavenyield.com,https://www.oakhavenyield.com
# ------------------------------------------------------------
CORS_ORIGIN=

# ------------------------------------------------------------
#  DATABASE
#  Empty  → local JSON file (development on your PC only!).
#  Set    → PostgreSQL. On your own VPS Postgres lives on the
#           same machine, reachable only via 127.0.0.1:
#
#  DATABASE_URL=postgresql://ohy:CHANGE_ME@127.0.0.1:5432/oakhaven
#
#  The app and the DB are on one host — TLS is irrelevant and
#  must be disabled with PGSSL=off. (Managed cloud databases
#  like Neon DO require TLS: leave PGSSL unset for them.)
# ------------------------------------------------------------
DATABASE_URL=
PGSSL=off

# ------------------------------------------------------------
#  Demo accounts (admin@trade.io / admin123 …)
#  Their passwords are PUBLIC knowledge — anyone can read them
#  in this repository. On production:
#    1) first boot  → SEED_DEMO=on  (you get an admin to enter the CRM)
#    2) log in, change ALL demo passwords in the CRM user list
#    3) afterwards  → SEED_DEMO=off + restart the service
# ------------------------------------------------------------
SEED_DEMO=on

# ------------------------------------------------------------
#  SMTP — real e-mail delivery (registration, password reset)
#  Leave empty in development: letters are written to
#  server/mails/*.html and the links printed to the console.
#  Providers that work well: Brevo, Mailgun, SendGrid, Amazon SES, Postmark.
# ------------------------------------------------------------
# Brevo (recommended, 300 free emails/day):
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_SECURE=false          <-- port 587 uses STARTTLS, so this MUST be false
#   SMTP_USER=<login shown on the Brevo "SMTP & API" page, e.g. 9a1b2c001@smtp-brevo.com>
#   SMTP_PASS=<the SMTP key generated on that page — NOT your Brevo account password>
#   SMTP_FROM=Oak Haven Yield <no-reply@oakhavenyield.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Oak Haven Yield <no-reply@oakhavenyield.com>
